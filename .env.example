# Copy this file to .env and adjust the values.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Asia/Kolkata

# "sqlite" works with zero setup. Use "postgres" for the recommended stack.
DB_ENGINE=sqlite

# Only needed when DB_ENGINE=postgres (matches docker-compose.yml)
DB_NAME=leave_db
DB_USER=leave_user
DB_PASSWORD=leave_pass
DB_HOST=localhost
DB_PORT=5432

# Email delivery (configure your SMTP provider to send rejection notices).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-smtp-or-app-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=your-email@example.com
